{
	"name": "@anvilkit/helps",
	"version": "0.2.1",
	"description": "Anvilkit Puck-native helps component.",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/cjs/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./styles.css": "./dist/styles.css",
		"./i18n/en.json": "./i18n/messages/en.json",
		"./i18n/zh.json": "./i18n/messages/zh.json",
		"./i18n/ja.json": "./i18n/messages/ja.json",
		"./i18n/ko.json": "./i18n/messages/ko.json"
	},
	"files": [
		"dist",
		"i18n",
		"README.md"
	],
	"license": "MIT",
	"sideEffects": [
		"./dist/index.js",
		"./dist/index.cjs",
		"**/*.css"
	],
	"scripts": {
		"build": "rslib build --lib esm && rslib build --lib cjs --no-clean",
		"dev": "rslib build --watch",
		"format": "pnpm exec biome format --write src rslib.config.ts",
		"typecheck": "tsc --noEmit",
		"publint": "publint",
		"size": "size-limit"
	},
	"peerDependencies": {
		"@anvilkit/ui": "^0.1.5",
		"@puckeditor/core": "^0.22.4",
		"react": ">=19.0.0",
		"react-dom": ">=19.0.0"
	},
	"devDependencies": {
		"@anvilkit/tailwind-config": "workspace:*",
		"@anvilkit/ui": "workspace:*"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"lucide-react": "^1.26.0"
	}
}
