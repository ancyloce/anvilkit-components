{
  "name": "{{packageName}}",
  "version": "0.1.0",
  "description": "{{description}}",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.cjs",
    "**/*.css"
  ],
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "format": "pnpm exec biome format --write src rslib.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@puckeditor/core": "^0.21.2",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@anvilkit/tailwind-config": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
