# packages/components is a SEPARATE pnpm workspace root (it has its own
# pnpm-workspace.yaml), so the repo-root .npmrc does NOT reach here — pnpm does
# not read .npmrc files above a workspace root. These settings mirror the
# repo-root .npmrc so the same mitigations actually take effect for this nested
# workspace.

# pnpm 11 runs a deps-status check before `pnpm run <script>` and spawns a
# `pnpm install` when it thinks the workspace is out of sync. Turbo runs each
# component's build with the cwd inside this workspace, so that auto-install
# fires on every build — and with this workspace's supply-chain policies it
# fails the run before the build even starts. CI installs this workspace
# explicitly (`pnpm --dir packages/components install ...`), so disable the
# per-run auto-check here.
verify-deps-before-run=false

# This workspace declares no build approvals of its own, and pnpm 10.13+ turns
# "ignored install scripts" (esbuild, core-js, msw) into a hard error. Downgrade
# that gate to a warning (CI passes the same via --config.strictDepBuilds=false).
strict-dep-builds=false

